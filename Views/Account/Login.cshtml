@model NeoxisAuthApp.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Sign In";
    Layout = "_AuthLayout";
}

<main class="login-wrap" id="auth-form">
    <div class="login-content">
        <a href="~/" class="auth-brand" aria-label="Neoxis home">
            <span class="logo-mark" aria-hidden="true">N</span>
            <span class="logo-text">Neoxis</span>
        </a>
        <h1 class="auth-title">Welcome back</h1>
        <p class="auth-subtitle">Sign in to continue to your dashboard.</p>

        @* ── Error from external provider (TempData set by callback action) ── *@
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger" style="margin-bottom:15px; padding:10px 14px; border-radius:6px; font-size:0.875rem;">
                @TempData["Error"]
            </div>
        }

        @* ── Email / Password form ── *@
        <form class="login-form" asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom:15px;"></div>

            <div class="form-group">
                <label asp-for="Email">Email address</label>
                <input asp-for="Email" class="au-input" placeholder="you@example.com" autocomplete="email" required />
                <span asp-validation-for="Email" class="text-danger" style="font-size:0.8em;"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">Password</label>
                <input asp-for="Password" class="au-input" placeholder="••••••••" autocomplete="current-password" required />
                <span asp-validation-for="Password" class="text-danger" style="font-size:0.8em;"></span>
            </div>

            <div class="login-checkbox">
                <label>
                    <input asp-for="RememberMe" />
                    Remember me
                </label>
            </div>

            <button class="au-btn au-btn--green" type="submit">Sign in</button>
        </form>

        @* ── OR separator ── *@
        <div style="display:flex; align-items:center; margin:20px 0; gap:12px; color:#aaa; font-size:0.8rem;">
            <div style="flex:1; height:1px; background:#e0e0e0;"></div>
            <span>OR</span>
            <div style="flex:1; height:1px; background:#e0e0e0;"></div>
        </div>

        @* ── External provider buttons ── *@
        <div class="social-login-content">
            <div class="social-button" style="display:flex; flex-direction:column; gap:10px;">

                <form asp-action="ExternalLogin" method="post">
                    <input type="hidden" name="provider" value="Google" />
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                    <button type="submit" class="au-btn au-btn--blue"
                            style="width:100%; display:flex; align-items:center; justify-content:center; gap:10px;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 48 48" aria-hidden="true">
                            <path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9 3.2l6.7-6.7C35.8 2.5 30.2 0 24 0 14.6 0 6.6 5.4 2.7 13.3l7.8 6C12.4 13 17.8 9.5 24 9.5z"/>
                            <path fill="#4285F4" d="M46.5 24.5c0-1.6-.1-3.1-.4-4.5H24v8.5h12.7c-.6 3-2.3 5.5-4.8 7.2l7.5 5.8C43.8 37.3 46.5 31.3 46.5 24.5z"/>
                            <path fill="#FBBC05" d="M10.5 28.7A14.5 14.5 0 0 1 9.5 24c0-1.6.3-3.2.8-4.7l-7.8-6A23.9 23.9 0 0 0 0 24c0 3.9.9 7.6 2.7 10.8l7.8-6.1z"/>
                            <path fill="#34A853" d="M24 48c6.2 0 11.4-2 15.2-5.5l-7.5-5.8c-2 1.4-4.7 2.3-7.7 2.3-6.2 0-11.5-4.2-13.4-9.8l-7.8 6C6.6 42.6 14.6 48 24 48z"/>
                        </svg>
                        Sign in with Google
                    </button>
                </form>

                <form asp-action="ExternalLogin" method="post">
                    <input type="hidden" name="provider" value="Microsoft" />
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                    <button type="submit" class="au-btn au-btn--blue2"
                            style="width:100%; display:flex; align-items:center; justify-content:center; gap:10px;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 21 21" aria-hidden="true">
                            <rect x="1"  y="1"  width="9" height="9" fill="#F25022"/>
                            <rect x="11" y="1"  width="9" height="9" fill="#7FBA00"/>
                            <rect x="1"  y="11" width="9" height="9" fill="#00A4EF"/>
                            <rect x="11" y="11" width="9" height="9" fill="#FFB900"/>
                        </svg>
                        Sign in with Microsoft
                    </button>
                </form>

            </div>
        </div>

        <div class="register-link">
            <p>Don't have an account? <a asp-action="Register">Create one</a></p>
        </div>
    </div>
</main>
