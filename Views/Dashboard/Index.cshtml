@model NeoxisAuthApp.Models.ApplicationUser

@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-header">
    <div>
        <h1>Dashboard</h1>
        <p class="subtitle">Welcome back, @Model.FullName &#x2014; here's your account overview.</p>
    </div>
</div>

<div class="row">
    <div class="col-md-6 col-lg-3">
        <div class="m-card text-center" style="padding:20px;">
            <i class="fa-solid fa-user fa-3x" style="color:#4272d7; margin-bottom:15px;"></i>
            <h3>Account Status</h3>
            <p class="text-success mt-2 font-weight-bold">Active</p>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="m-card text-center" style="padding:20px;">
            <i class="fa-solid fa-envelope fa-3x" style="color:#10b981; margin-bottom:15px;"></i>
            <h3>Email</h3>
            <p class="mt-2 text-muted" style="word-break: break-all;">@Model.Email</p>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="m-card text-center" style="padding:20px;">
            <i class="fa-solid fa-calendar-check fa-3x" style="color:#f59e0b; margin-bottom:15px;"></i>
            <h3>Member Since</h3>
            <p class="mt-2 text-muted">@Model.CreatedAt.ToString("MMM dd, yyyy")</p>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="m-card text-center" style="padding:20px;">
            <i class="fa-solid fa-shield-halved fa-3x" style="color:#ef4444; margin-bottom:15px;"></i>
            <h3>Security</h3>
            <p class="mt-2 text-muted">Protected</p>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-lg-12">
        <div class="m-card">
            <header class="m-card__header">
                <h2 class="m-card__title">Recent Activity</h2>
            </header>
            <div class="m-card__body p-4 text-center">
                <p class="text-muted">No recent activity to show.</p>
            </div>
        </div>
    </div>
</div>
